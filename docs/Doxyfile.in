PROJECT_NAME           = "QuantLab"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "C++17 library for reproducible financial time-series analysis"
OUTPUT_DIRECTORY       = "@CMAKE_BINARY_DIR@/docs"
OUTPUT_LANGUAGE        = Russian
INPUT_ENCODING         = UTF-8
INPUT                  = "@CMAKE_SOURCE_DIR@/include" "@CMAKE_SOURCE_DIR@/docs/mainpage.md"
FILE_PATTERNS          = *.hpp *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE  = "@CMAKE_SOURCE_DIR@/docs/mainpage.md"
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = "@CMAKE_SOURCE_DIR@/"
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = LIGHT
GENERATE_TREEVIEW      = YES
HTML_DYNAMIC_SECTIONS  = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
GENERATE_LATEX         = NO
GENERATE_XML           = NO
HAVE_DOT               = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
